# One-time setup — copy via: npm run setup
# This file is loaded permanently from config/.env (survives restarts and rebuilds).
# Never commit config/.env.

# --- Shopify (required for live store) ---
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_MOCK_MODE=false
SHOPIFY_READ_ONLY=true

# --- Discord bridge ---
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# --- MCP server ---
PORT=3000
# Auto-generated by npm run setup. Required if MCP is exposed publicly (n8n Cloud).
MCP_API_KEY=

# --- n8n (local Docker) ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/discord
N8N_PORT=5678
N8N_HOST=localhost
TZ=UTC