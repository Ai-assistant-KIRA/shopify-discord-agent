# Copy to .env — never commit .env

# Shopify — use real store data (set SHOPIFY_MOCK_MODE=true for offline demo)
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_MOCK_MODE=false
SHOPIFY_CLI_AUTH=false
SHOPIFY_READ_ONLY=true

# MCP server
PORT=3000
MCP_API_KEY=

# Discord bridge (scripts/discord-bridge.mjs)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=
N8N_WEBHOOK_URL=http://localhost:5678/webhook/discord

# Optional: import workflow via scripts/import-workflow.mjs
N8N_API_URL=http://localhost:5678/api/v1/workflows
N8N_API_KEY=