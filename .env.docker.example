# Copy to .env before running: cp .env.docker.example .env

# --- Shopify (set SHOPIFY_MOCK_MODE=true for offline demo) ---
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_MOCK_MODE=false
SHOPIFY_READ_ONLY=true

# --- MCP server (exposed to host at localhost:3000) ---
PORT=3000
MCP_PORT=3000
MCP_API_KEY=

# --- Discord bridge (runs inside Docker network; talks to n8n service) ---
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=

# --- n8n (UI at http://localhost:5678) ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=UTC

# Optional: import workflow from host after n8n starts
N8N_API_URL=http://localhost:5678/api/v1/workflows
N8N_API_KEY=